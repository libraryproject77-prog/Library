{
  "name": "fxec-ece-library",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "dev:api": "npm --workspace=apps/api run dev",
    "build": "npm --workspace=packages/shared run build && npm --workspace=apps/web run build",
    "start:api": "npm --workspace=apps/api run start"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
